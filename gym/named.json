[{"id":"barry","nm":"용식","cls":"라이벌","tr":"rival_barry","ow":"barry","music":"rival","ln":["{me}! 너 체육관 관장이 됐다며?! 늦으면 벌금 백만 원이다! 빨리 배틀하자!","으아아… 졌다! 다음엔 꼭 이길 거야, 기다려!","봤냐! 이게 바로 나 용식의 실력이다!"],"st":[[[396,7,["quickattack","growl"]],[393,9,["pound","growl"]]],[[397,25,["wingattack","quickattack","endeavor","doubleteam"]],[315,23,["megadrain","poisonsting","leechseed","stunspore"]],[77,23,["ember","tackle","tailwhip","growl"]],[394,27,["bubblebeam","peck","metalclaw","growl"]]],[[397,34,["wingattack","quickattack","endeavor","doubleteam"]],[315,32,["megadrain","poisonsting","leechseed","magicalleaf"]],[77,32,["ember","stomp","tailwhip","growl"]],[394,36,["bubblebeam","peck","metalclaw","growl"]]],[[398,36,["aerialace","takedown","quickattack","doubleteam"]],[407,35,["gigadrain","toxicspikes","leechseed","grasswhistle"]],[214,37,["brickbreak","aerialace","nightslash","hornattack"]],[78,35,["firespin","takedown","stomp","tailwhip"]],[395,38,["bubblebeam","aerialace","metalclaw","furyattack"]]],[[398,48,["closecombat","aerialace","steelwing","uturn"]],[407,47,["poisonjab","gigadrain","shadowball","grasswhistle"]],[214,48,["closecombat","rockslide","nightslash","aerialace"]],[78,47,["fireblast","sunnyday","bounce","willowisp"]],[143,49,["bodyslam","crunch","earthquake","rest"]],[395,51,["brine","aerialace","metalclaw","shadowclaw"]]]],"ex":["요즘 동네에 소문 쫙 났더라. {me} 체육관이 장난 아니라고!","근데 그거 알아? 최강은 바로 나라는 거! 자, 간다!"]},{"id":"roark","nm":"강석","cls":"무쇠시티 관장","tr":"leader_roark","ow":"roark","music":"gymBattle","ln":["나는 무쇠시티 관장 강석! 광산에서 단련한 바위 포켓몬으로 도전하겠다!","훌륭해! 네 체육관은 바위처럼 단단하구나!","하하! 화석처럼 단단한 내 포켓몬을 얕보지 마라!"],"st":[[[74,12,["stealthrock","rockthrow"]],[95,12,["stealthrock","rockthrow","screech"]],[408,14,["headbutt","pursuit","leer"]]],[[142,62,["stoneedge","aerialace","earthquake","dragonclaw"]],[476,61,["earthpower","stealthrock","discharge","stoneedge"]],[76,61,["stoneedge","earthquake","brickbreak","flamethrower"]],[409,63,["headsmash","zenheadbutt","avalanche","earthquake"]],[248,65,["stoneedge","crunch","aerialace","firefang"]]]],"ex":["관장이 된 걸 축하하네. 하지만 체육관은 이름만으로 지켜지는 게 아니지.","바위처럼 단단한 각오가 있는지, 이 배틀로 확인하겠다!"]},{"id":"gardenia","nm":"유채","cls":"영원시티 관장","tr":"leader_gardenia","ow":"gardenia","music":"gymBattle","ln":["안녕! 풀 포켓몬 좋아해? 내 귀여운 아이들이랑 한판 하자!","와아, 졌다! 너 정말 대단하구나!","후후, 풀 포켓몬의 힘 봤지?"],"st":[[[387,20,["grassknot","razorleaf","sunnyday","reflect"]],[421,20,["grassknot","leechseed","magicalleaf","safeguard"]],[407,22,["grassknot","magicalleaf","poisonsting","stunspore"]]],[[189,61,["silverwind","toxic","sunnyday","bounce"]],[421,62,["solarbeam","toxic","sunnyday","leechseed"]],[182,61,["drainpunch","gigadrain","ingrain","sunnyday"]],[389,63,["woodhammer","crunch","earthquake","stoneedge"]],[407,65,["shadowball","leafstorm","sludgebomb","hyperbeam"]]]],"ex":["네 체육관 오는 길에 꽃이 엄청 예쁘게 피어 있더라. 기분 좋아졌어!","그러니까 봐주는 거 없이 전력으로 갈게. 꽃잎처럼 휘날려 줄게!"]},{"id":"maylene","nm":"자두","cls":"베일시티 관장","tr":"leader_maylene","ow":"maylene","music":"gymBattle","ln":["저는 베일시티 관장 자두예요. 맨발로… 아니, 전력으로 부딪힐게요!","…제가 졌어요. 더 수행해야겠어요.","이게 격투의 힘이에요!"],"st":[[[307,28,["drainpunch","confusion","rocktomb","fakeout"]],[67,29,["karatechop","rocktomb","strength","focusenergy"]],[448,32,["drainpunch","forcepalm","metalclaw","bonerush"]]],[[237,62,["triplekick","aerialace","quickattack","fakeout"]],[308,63,["firepunch","icepunch","thunderpunch","highjumpkick"]],[286,62,["stoneedge","spore","machpunch","seedbomb"]],[68,64,["crosschop","rockclimb","earthquake","stoneedge"]],[448,66,["drainpunch","closecombat","extremespeed","bonerush"]]]],"ex":["체육관을 지키는 건 생각보다 훨씬 무거운 일이에요. 저도 그걸 배웠거든요.","관장님의 마음이 얼마나 강한지, 주먹으로 확인해 볼게요!"]},{"id":"wake","nm":"맥실러","cls":"늪지시티 관장","tr":"leader_wake","ow":"crasher_wake","music":"gymBattle","ln":["와하하! 물보라 마스크 맥실러 등장! 파도처럼 덮쳐 주마!","우오오… 내 파도가 부서지다니!","이것이 맥실러의 거친 물결이다!"],"st":[[[130,33,["waterfall","brine","bite","twister"]],[195,34,["mudshot","rocktomb","waterpulse","yawn"]],[419,37,["brine","icefang","crunch","aquajet"]]],[[319,61,["aquajet","nightslash","slash","endure"]],[195,61,["earthquake","stoneedge","yawn","surf"]],[130,62,["aquatail","avalanche","bite","gigaimpact"]],[419,63,["brine","icefang","crunch","aquajet"]],[272,65,["surf","icebeam","energyball","focusblast"]]]],"ex":["체육관 관장이라면 어떤 파도가 와도 끄떡없어야지!","이 몸의 물 포켓몬이 일으키는 거대한 물보라, 버텨 낼 수 있겠나?!"]},{"id":"fantina","nm":"멜리사","cls":"연고시티 관장","tr":"leader_fantina","ow":"fantina","music":"gymBattle","ln":["봉주르! 멜리사예요. 고스트 포켓몬의 춤, 보여 줄게요!","오… 당신, 정말 트레비앙이에요!","후후, 아름다운 승리네요!"],"st":[[[355,24,["willowisp","pursuit","shadowsneak","futuresight"]],[93,24,["shadowclaw","suckerpunch","hypnosis","confuseray"]],[429,26,["shadowball","psybeam","magicalleaf","confuseray"]]],[[354,61,["shadowclaw","feintattack","thunderbolt","willowisp"]],[426,61,["ominouswind","psychic","silverwind","batonpass"]],[477,62,["rockslide","shadowpunch","doubleteam","protect"]],[429,63,["shadowball","psychic","magicalleaf","thunderbolt"]],[94,65,["shadowball","psychic","focusblast","thunder"]]]],"ex":["관장님 체육관, 무대처럼 반짝반짝해요. 마음에 들어요.","그럼 이제 막을 올릴까요? 제 아이들이 춤추기 시작하면 멈출 수 없어요!"]},{"id":"byron","nm":"동관","cls":"운하시티 관장","tr":"leader_byron","ow":"byron","music":"gymBattle","ln":["우하하! 강철처럼 단단한 내 포켓몬을 뚫을 수 있겠느냐!","음! 네 실력, 강철도 녹이는구나!","강철은 쉽게 꺾이지 않는다!"],"st":[[[82,37,["flashcannon","thunderbolt","triattack","metalsound"]],[208,38,["flashcannon","icefang","earthquake","sandstorm"]],[411,41,["metalburst","stoneedge","irondefense","taunt"]]],[[227,61,["nightslash","drillpeck","rocktomb","stealthrock"]],[208,61,["gyroball","icefang","dragonbreath","sandstorm"]],[462,62,["flashcannon","thunderbolt","supersonic","thunderwave"]],[411,63,["metalburst","ancientpower","irondefense","rest"]],[306,65,["metalburst","stoneedge","earthquake","avalanche"]]]],"ex":["내 아들 강석한테 얘기 들었다! 꽤 하는 관장이 나타났다고!","하지만 강철의 벽은 그리 쉽게 뚫리지 않는다! 각오해라!"]},{"id":"candice","nm":"무청","cls":"선단시티 관장","tr":"leader_candice","ow":"candice","music":"gymBattle","ln":["선단시티 관장 무청이야! 집중력 하면 나지! 얼음처럼 시원하게 가자!","으으, 졌다! 그래도 엄청 재밌었어!","집중력이 승부를 가르는 거야!"],"st":[[[215,40,["slash","aerialace","feintattack","iceshard"]],[221,40,["avalanche","stoneedge","earthquake","hail"]],[460,42,["avalanche","woodhammer","waterpulse","focusblast"]],[478,44,["blizzard","doubleteam","shadowball","psychic"]]],[[461,62,["avalanche","slash","feintattack","taunt"]],[473,61,["avalanche","ancientpower","earthquake","hail"]],[460,61,["avalanche","woodhammer","grasswhistle","ingrain"]],[478,63,["blizzard","confuseray","ominouswind","hail"]],[471,65,["blizzard","mirrorcoat","shadowball","waterpulse"]]]],"ex":["여기 오는 길에 눈이 펑펑 내렸는데, 마음은 오히려 뜨거워졌어!","집중! 집중! 한순간이라도 방심하면 꽁꽁 얼려 버릴 거야!"]},{"id":"volkner","nm":"전진","cls":"물가시티 관장","tr":"leader_volkner","ow":"volkner","music":"gymBattle","ln":["…요즘 배틀이 시시했거든. 네 체육관은 나를 짜릿하게 해 줄까?","…오랜만에 짜릿했다. 고맙다.","아직 내 전기를 감당하긴 이르군."],"st":[[[135,46,["thunderwave","chargebeam","irontail","quickattack"]],[26,46,["chargebeam","focusblast","signalbeam","quickattack"]],[405,48,["icefang","thunderfang","crunch","firefang"]],[466,50,["thunderpunch","firepunch","quickattack","gigaimpact"]]],[[135,61,["pinmissile","chargebeam","doublekick","quickattack"]],[26,61,["chargebeam","brickbreak","thunderwave","lightscreen"]],[405,62,["icefang","thunderfang","crunch","firefang"]],[171,63,["discharge","signalbeam","surf","icebeam"]],[466,65,["thunderpunch","firepunch","brickbreak","gigaimpact"]]]],"ex":["물가시티 등대에서 보면 여기까지 반짝이는 게 보이더군.","실망시키지 마. 오랜만에 전력을 낼 생각이니까."]},{"id":"aaron","nm":"충호","cls":"사천왕","tr":"elite_four_aaron","ow":"aaron","music":"champ","ln":["사천왕 충호! 벌레 포켓몬의 아름다움과 강함을 보여 주지!","…졌다. 내 벌레 포켓몬들, 미안해.","벌레 포켓몬은 약하지 않아!"],"st":[[[469,49,["airslash","bugbuzz","uturn","doubleteam"]],[212,49,["ironhead","xscissor","nightslash","quickattack"]],[416,50,["attackorder","defendorder","powergem"]],[214,51,["megahorn","closecombat","nightslash","stoneedge"]],[452,53,["xscissor","crosspoison","icefang","aerialace"]]],[[469,65,["airslash","bugbuzz","uturn","doubleteam"]],[212,65,["ironhead","xscissor","nightslash","quickattack"]],[416,66,["attackorder","defendorder","powergem"]],[214,67,["megahorn","closecombat","nightslash","stoneedge"]],[452,69,["xscissor","crosspoison","icefang","aerialace"]]]],"ex":["작은 벌레 포켓몬도 끝까지 포기하지 않으면 누구보다 강해지지.","그 강함, 사천왕의 이름을 걸고 보여 주겠다!"]},{"id":"bertha","nm":"들국화","cls":"사천왕","tr":"elite_four_bertha","ow":"bertha","music":"champ","ln":["어머, 젊은 관장님이네. 이 할미랑 한판 하겠누?","호호호, 정말 잘 키웠구나.","아직 땅이 단단하지 않구나."],"st":[[[340,50,["earthpower","aquatail","zenheadbutt","sandstorm"]],[472,53,["earthquake","icefang","firefang","thunderfang"]],[450,52,["earthquake","stoneedge","crunch","yawn"]],[76,52,["earthquake","firepunch","thunderpunch","sandstorm"]],[464,55,["earthquake","rockwrecker","megahorn","avalanche"]]],[[340,66,["earthpower","aquatail","zenheadbutt","sandstorm"]],[472,69,["earthquake","icefang","firefang","thunderfang"]],[450,68,["earthquake","stoneedge","crunch","yawn"]],[76,68,["earthquake","firepunch","thunderpunch","sandstorm"]],[464,71,["earthquake","rockwrecker","megahorn","avalanche"]]]],"ex":["이 할미도 젊을 땐 관장님처럼 반짝였지. 그 마음 잊지 말려무나.","자, 그럼 땅처럼 묵직한 배틀, 한번 맛보겠누?"]},{"id":"flint","nm":"대엽","cls":"사천왕","tr":"elite_four_flint","ow":"flint","music":"champ","ln":["사천왕 대엽이다! 내 불꽃만큼 뜨거운 배틀을 하자고!","이야… 완전히 불타 버렸어!","이 열기, 느껴지냐!"],"st":[[[229,52,["flamethrower","sludgebomb","darkpulse","sunnyday"]],[136,55,["overheat","gigaimpact","quickattack","willowisp"]],[78,53,["flareblitz","solarbeam","bounce","sunnyday"]],[392,55,["flareblitz","thunderpunch","machpunch","earthquake"]],[467,57,["flamethrower","thunderbolt","solarbeam","hyperbeam"]]],[[229,68,["flamethrower","sludgebomb","darkpulse","sunnyday"]],[136,71,["overheat","gigaimpact","quickattack","willowisp"]],[78,69,["flareblitz","solarbeam","bounce","sunnyday"]],[392,71,["flareblitz","thunderpunch","machpunch","earthquake"]],[467,73,["flamethrower","thunderbolt","solarbeam","hyperbeam"]]]],"ex":["체육관에 불꽃이 활활 타오르는 게 느껴져! 그런 녀석이랑 싸우고 싶었지!","망설임 같은 건 다 태워 버려! 뜨겁게 가자!"]},{"id":"lucian","nm":"오엽","cls":"사천왕","tr":"elite_four_lucian","ow":"lucian","music":"champ","ln":["사천왕 오엽입니다. 책을 덮고, 승부에 집중하지요.","…훌륭합니다. 정말 좋은 배틀이었어요.","결말은 예상대로군요."],"st":[[[122,53,["psychic","thunderbolt","reflect","lightscreen"]],[196,55,["psychic","shadowball","quickattack","signalbeam"]],[437,54,["psychic","gyroball","earthquake","calmmind"]],[65,56,["psychic","energyball","focusblast","recover"]],[475,59,["drainpunch","psychocut","leafblade","stoneedge"]]],[[122,69,["psychic","thunderbolt","reflect","lightscreen"]],[196,71,["psychic","shadowball","quickattack","signalbeam"]],[437,70,["psychic","gyroball","earthquake","calmmind"]],[65,72,["psychic","energyball","focusblast","recover"]],[475,75,["drainpunch","psychocut","leafblade","stoneedge"]]]],"ex":["당신의 체육관 기록을 읽어 보았습니다. 흥미로운 이야기더군요.","이제 다음 장을 함께 써 봅시다. 결말이 어떨지는… 배틀이 정하겠지요."]},{"id":"cynthia","nm":"난천","cls":"챔피언","tr":"champion_cynthia","ow":"cynthia","music":"champ","ln":["안녕, 관장님. 네 체육관 이야기를 듣고 왔어. 챔피언으로서 진지하게 상대할게.","…멋진 배틀이었어. 네 포켓몬을 향한 마음이 느껴져.","포켓몬과 함께라면 더 강해질 수 있을 거야."],"st":[[[442,58,["darkpulse","psychic","silverwind","shadowball"]],[407,58,["energyball","sludgebomb","toxic","extrasensory"]],[468,60,["airslash","aurasphere","waterpulse","shockwave"]],[448,60,["aurasphere","extremespeed","shadowball","stoneedge"]],[350,58,["surf","icebeam","mirrorcoat","dragonpulse"]],[445,62,["dragonrush","earthquake","flamethrower","gigaimpact"]]],[[442,74,["darkpulse","psychic","silverwind","ominouswind"]],[407,74,["energyball","sludgebomb","shadowball","extrasensory"]],[468,76,["airslash","aurasphere","waterpulse","psychic"]],[448,76,["aurasphere","dragonpulse","psychic","earthquake"]],[350,74,["surf","icebeam","mirrorcoat","aquaring"]],[445,78,["dragonrush","earthquake","brickbreak","gigaimpact"]]]],"ex":["포켓몬과 사람이 마음을 모으면, 어떤 벽도 넘을 수 있다고 믿어.","네가 포켓몬과 쌓아 온 시간, 전부 보여 줘. 나도 전력을 다할게."]},{"id":"red","nm":"레드","cls":"포켓몬 트레이너","tr":"hg_red","ow":"red_normal","music":"champ","ln":["……","……!","……"],"st":[[[25,88,["volttackle","irontail","quickattack","thunderbolt"]],[131,80,["blizzard","brine","psychic","bodyslam"]],[143,82,["shadowball","crunch","blizzard","gigaimpact"]],[3,84,["sludgebomb","gigadrain","sleeppowder","frenzyplant"]],[6,84,["flareblitz","airslash","blastburn","dragonpulse"]],[9,84,["focusblast","hydrocannon","blizzard","flashcannon"]]]]},{"id":"green","nm":"그린","cls":"상록시티 관장","tr":"hg_green","ow":"blue","music":"rival","ln":["어이! 네가 요즘 소문난 관장이라며? 이 그린 님이 직접 확인하러 왔다!","쳇… 제법인데. 다음엔 안 봐준다!","하하! 역시 내가 최강이라니까!"],"st":[[[103,55,["leafstorm","psychic","hypnosis","trickroom"]],[59,58,["roar","dragonpulse","flareblitz","extremespeed"]],[112,58,["megahorn","stoneedge","thunderfang","earthquake"]],[130,52,["icefang","waterfall","dragondance","return"]],[68,56,["dynamicpunch","earthquake","stoneedge","thunderpunch"]],[18,60,["return","whirlwind","airslash","mirrormove"]]],[[103,67,["leafstorm","psychic","explosion","trickroom"]],[68,69,["dynamicpunch","stoneedge","fling","attract"]],[464,70,["megahorn","stoneedge","thunderfang","earthquake"]],[59,68,["flareblitz","extremespeed","thunderfang","crunch"]],[248,70,["lowkick","firefang","rockslide","earthquake"]],[18,72,["return","doubleteam","airslash","steelwing"]]]]},{"id":"silver","nm":"실버","cls":"라이벌","tr":"hg_silver","ow":"boy","music":"rival","ln":["…네가 관장이라고? 약한 녀석은 관장 자격 없어. 내가 증명해 주지.","…쳇. 이번엔 인정해 주지.","흥, 역시 약한 녀석이었군."],"st":[[[92,14,[]],[41,16,[]],[159,18,[]]],[[92,20,["lick","confuseray","meanlook","curse"]],[81,18,["thunderwave","thundershock","supersonic","sonicboom"]],[41,20,["astonish","supersonic","bite","wingattack"]],[159,22,["scaryface","icefang","watergun","bite"]]],[[42,30,["astonish","bite","confuseray","aircutter"]],[81,28,["supersonic","spark","sonicboom","thunderwave"]],[93,30,["confuseray","meanlook","curse","shadowball"]],[215,32,["icywind","quickattack","furyswipes","feintattack"]],[160,32,["icefang","watergun","crunch","thrash"]]],[[215,36,["quickattack","icywind","feintattack","furyswipes"]],[42,38,["astonish","bite"