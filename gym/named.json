t"]],[59,47,["bite","roar","takedown","fireblast"]]]]},{"id":"giovanni","nm":"비주기","cls":"상록시티 관장","tr":"leader_giovanni","ow":"giovanni","music":"gymBattle","ln":["후후… 네 체육관이 소문이 자자하더군. 직접 확인하러 왔다.","…훌륭하다. 오늘은 이만 물러나지.","이것이 진정한 강자의 힘이다."],"st":[[[111,45,["takedown","rockblast","scaryface","earthquake"]],[51,42,["slash","sandtomb","mudslap","earthquake"]],[31,44,["bodyslam","doublekick","poisonsting","earthquake"]],[34,45,["thrash","doublekick","poisonsting","earthquake"]],[111,50,["takedown","rockblast","scaryface","earthquake"]]]]},{"id":"lorelei","nm":"칸나","cls":"사천왕","tr":"elite_four_lorelei","ow":"lorelei","music":"champ","ln":["사천왕 칸나야. 얼음 포켓몬으로 꽁꽁 얼려 줄게.","어머… 제법이네.","얼음은 쉽게 녹지 않아."],"st":[[[87,52,["icebeam","surf","hail","safeguard"]],[91,51,["spikes","protect","hail","dive"]],[80,52,["icebeam","surf","amnesia","yawn"]],[124,54,["icepunch","doubleslap","lovelykiss","attract"]],[131,54,["confuseray","icebeam","surf","bodyslam"]]],[[87,64,["icebeam","surf","signalbeam","doubleteam"]],[91,63,["icebeam","surf","supersonic","raindance"]],[221,63,["blizzard","earthquake","doubleedge","rockslide"]],[124,66,["icebeam","psychic","lovelykiss","attract"]],[131,66,["icebeam","surf","psychic","thunder"]]]]},{"id":"bruno","nm":"시바","cls":"사천왕","tr":"elite_four_bruno","ow":"bruno","music":"champ","ln":["나는 사천왕 시바! 단련된 근육으로 상대해 주마! 후!","이럴 수가… 내가 지다니!","단련이 부족하다!"],"st":[[[95,51,["earthquake","rocktomb","irontail","roar"]],[107,53,["skyuppercut","machpunch","rocktomb","counter"]],[106,53,["megakick","foresight","brickbreak","facade"]],[95,54,["doubleedge","earthquake","irontail","sandtomb"]],[68,56,["crosschop","bulkup","scaryface","rocktomb"]]],[[208,65,["earthquake","irontail","crunch","rocktomb"]],[107,65,["skyuppercut","machpunch","rockslide","counter"]],[106,65,["megakick","foresight","earthquake","rockslide"]],[208,66,["earthquake","irontail","crunch","dragonbreath"]],[68,68,["crosschop","earthquake","brickbreak","rockslide"]]]]},{"id":"agatha","nm":"국화","cls":"사천왕"