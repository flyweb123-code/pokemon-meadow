[{"id":"barry","nm":"용식","cls":"라이벌","tr":"rival_barry","ow":"barry","music":"rival","ln":["{me}! 너 체육관 관장이 됐다며?! 늦으면 벌금 백만 원이다! 빨리 배틀하자!","으아아… 졌다! 다음엔 꼭 이길 거야, 기다려!","봤냐! 이게 바로 나 용식의 실력이다!"],"st":[[[396,7,["quickattack","growl"]],[393,9,["pound","growl"]]],[[397,25,["wingattack","quickattack","endeavor","doubleteam"]],[315,23,["megadrain","poisonsting","leechseed","stunspore"]],[77,23,["ember","tackle","tailwhip","growl"]],[394,27,["bubblebeam","peck","metalclaw","growl"]]],[[397,34,["wingattack","quickattack","endeavor","doubleteam"]],[315,32,["megadrain","poisonsting","leechseed","magicalleaf"]],[77,32,["ember","stomp","tailwhip","growl"]],[394,36,["bubblebeam","peck","metalclaw","growl"]]],[[398,36,["aerialace","takedown","quickattack","doubleteam"]],[407,35,["gigadrain","toxicspikes","leechseed","grasswhistle"]],[214,37,["brickbreak","aerialace","nightslash","hornattack"]],[78,35,["firespin","takedown","stomp","tailwhip"]],[395,38,["bubblebeam","aerialace","metalclaw","furyattack"]]],[[398,48,["closecombat","aerialace","steelwing","uturn"]],[407,47,["poisonjab","gigadrain","shadowball","grasswhistle"]],[214,48,["closecombat","rockslide","nightslash","aerialace"]],[78,47,["fireblast","sunnyday","bounce","willowisp"]],[143,49,["bodyslam","crunch","earthquake","rest"]],[395,51,["brine","aerialace","metalclaw","shadowclaw"]]]]},{"id":"roark","nm":"강석","cls":"무쇠시티 관장","tr":"leader_roark","ow":"roark","music":"gymBattle","ln":["나는 무쇠시티 관장 강석! 광산에서 단련한 바위 포켓몬으로 도전하겠다!","훌륭해! 네 체육관은 바위처럼 단단하구나!","하하! 화석처럼 단단한 내 포켓몬을 얕보지 마라!"],"st":[[[74,12,["stealthrock","rockthrow"]],[95,12,["stealthrock","rockthrow","screech"]],[408,14,["headbutt","pursuit","leer"]]],[[142,62,["stoneedge","aerialace","earthquake","dragonclaw"]],[476,61,["earthpower","stealthrock","discharge","stoneedge"]],[76,61,["stoneedge","earthquake","brickbreak","flamethrower"]],[409,63,["headsmash","zenheadbutt","avalanche","earthquake"]],[248,65,["stoneedge","crunch","aerialace","firefang"]]]]},{"id":"gardenia","nm":"유채","cls":"영원시티 관장","tr":"leader_gardenia","ow":"gardenia","music":"gymBattle","ln":["안녕! 풀 포켓몬 좋아해? 내 귀여운 아이들이랑 한판 하자!","와아, 졌다! 너 정말 대단하구나!","후후, 풀 포켓몬의 힘 봤지?"],"st":[[[387,20,["grassknot","razorleaf","sunnyday","reflect"]],[421,20,["grassknot","leechseed","magicalleaf","safeguard"]],[407,22,["grassknot","magicalleaf","poisonsting","stunspore"]]],[[189,61,["silverwind","toxic","sunnyday","bounce"]],[421,62,["solarbeam","toxic","sunnyday","leechseed"]],[182,61,["drainpunch","gigadrain","ingrain","sunnyday"]],[389,63,["woodhammer","crunch","earthquake","stoneedge"]],[407,65,["shadowball","leafstorm","sludgebomb","hyperbeam"]]]]},{"id":"maylene","nm":"자두","cls":"베일시티 관장","tr":"leader_maylene","ow":"maylene","music":"gymBattle","ln":["저는 베일시티 관장 자두예요. 맨발로… 아니, 전력으로 부딪힐게요!","…제가 졌어요. 더 수행해야겠어요.","이게 격투의 힘이에요!"],"st":[[[307,28,["drainpunch","confusion","rocktomb","fakeout"]],[67,29,["karatechop","rocktomb","strength","focusenergy"]],[448,32,["drainpunch","forcepalm","metalclaw","bonerush"]]],[[237,62,["triplekick","aerialace","quickattack","fakeout"]],[308,63,["firepunch","icepunch","thunderpunch","highjumpkick"]],[286,62,["stoneedge","spore","machpunch","seedbomb"]],[68,64,["crosschop","rockclimb","earthquake","stoneedge"]],[448,66,["drainpunch","closecombat","extremespeed","bonerush"]]]]},{"id":"wake","nm":"맥실러","cls":"늪지시티 관장","tr":"leader_wake","ow":"crasher_wake","music":"gymBattle","ln":["와하하! 물보라 마스크 맥실러 등장! 파도처럼 덮쳐 주마!","우오오… 내 파도가 부서지다니!","이것이 맥실러의 거친 물결이다!"],"st":[[[130,33,["waterfall","brine","bite","twister"]],[195,34,["mudshot","rocktomb","waterpulse","yawn"]],[419,37,["brine","icefang","crunch","aquajet"]]],[[319,61,["aquajet","nightslash","slash","endure"]],[195,61,["earthquake","stoneedge","yawn","surf"]],[130,62,["aquatail","avalanche","bite","gigaimpact"]],[419,63,["brine","icefang","crunch","aquajet"]],[272,65,["surf","icebeam","energyball","focusblast"]]]]},{"id":"fantina","nm":"멜리사","cls":"연고시티 관장","tr":"leader_fantina","ow":"fantina","musi